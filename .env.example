# WM Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Backend API base URL — no trailing slash
# Development:  http://127.0.0.1:8000
# Staging:      https://api-staging.your-domain.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# AUTH — Configure when backend auth strategy is finalized
# Uncomment the relevant line when ready.
# ---------------------------------------------------------------------------

# Option A: Bearer token (JWT)
# VITE_API_TOKEN=your_jwt_token_here

# Option B: Static API key
# VITE_API_KEY=your_api_key_here

# Option C: Session cookie — no variable needed (browser handles automatically)
